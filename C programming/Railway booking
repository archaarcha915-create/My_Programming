#include <stdio.h>
#include <string.h>

#define ROWS 5
#define SEATS 4

struct Passenger
{
    char name[50];
    int age;
    int row;
    int seat;
    int booked;
};

int main()
{
    int seats[ROWS][SEATS] = {0};

    struct Passenger passenger[ROWS * SEATS];

    int choice;
    int i, j;
    int row, seat;
    int index;
    int totalBooked = 0;
    char searchName[50];
    int found;

    /* Initialize passenger records */
    for(i = 0; i < ROWS * SEATS; i++)
    {
        passenger[i].booked = 0;
    }

    do
    {
        printf("\n=====================================\n");
        printf("     RAILWAY RESERVATION SYSTEM\n");
        printf("=====================================\n");
        printf("1. Display Seat Availability\n");
        printf("2. Book a Ticket\n");
        printf("3. Cancel a Ticket\n");
        printf("4. Search Passenger\n");
        printf("5. Display Reservation Details\n");
        printf("6. Display Available Seats\n");
        printf("7. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            /* -------------------------------- */
            /* 1. DISPLAY SEAT AVAILABILITY     */
            /* -------------------------------- */
            case 1:

                printf("\n");
                printf("          SEAT AVAILABILITY\n");
                printf("-----------------------------------\n");

                printf("        1    2    3    4\n");

                for(i = 0; i < ROWS; i++)
                {
                    printf("Row %d  ", i + 1);

                    for(j = 0; j < SEATS; j++)
                    {
                        if(seats[i][j] == 0)
                        {
                            printf("[ O ] ");
                        }
                        else
                        {
                            printf("[ X ] ");
                        }
                    }

                    printf("\n");
                }

                printf("\nO -> Available\n");
                printf("X -> Booked\n");

                break;


            /* -------------------------------- */
            /* 2. BOOK A TICKET                 */
            /* -------------------------------- */
            case 2:

                if(totalBooked == ROWS * SEATS)
                {
                    printf("\nAll seats are already booked.\n");
                    break;
                }

                printf("\nEnter Passenger Name: ");
                scanf(" %[^\n]", searchName);

                printf("Enter Age: ");
                scanf("%d", &passenger[totalBooked].age);

                printf("Enter Row Number (1-5): ");
                scanf("%d", &row);

                printf("Enter Seat Number (1-4): ");
                scanf("%d", &seat);

                /* Validate row */
                if(row < 1 || row > ROWS)
                {
                    printf("\nInvalid row number!\n");
                    break;
                }

                /* Validate seat */
                if(seat < 1 || seat > SEATS)
                {
                    printf("\nInvalid seat number!\n");
                    break;
                }

                /* Check whether seat is already booked */
                if(seats[row - 1][seat - 1] == 1)
                {
                    printf("\nSorry! This seat is already booked.\n");
                    printf("Please select another seat.\n");
                    break;
                }

                /* Store passenger information */
                strcpy(passenger[totalBooked].name, searchName);

                passenger[totalBooked].row = row;
                passenger[totalBooked].seat = seat;
                passenger[totalBooked].booked = 1;

                /* Mark seat as booked */
                seats[row - 1][seat - 1] = 1;

                printf("\n================================\n");
                printf("          TICKET BOOKED\n");
                printf("================================\n");
                printf("Passenger : %s\n", passenger[totalBooked].name);
                printf("Age       : %d\n", passenger[totalBooked].age);
                printf("Seat      : %d-%d\n", row, seat);
                printf("Booking successful!\n");

                totalBooked++;

                break;


            /* -------------------------------- */
            /* 3. CANCEL A TICKET               */
            /* -------------------------------- */
            case 3:

                printf("\nEnter Row Number (1-5): ");
                scanf("%d", &row);

                printf("Enter Seat Number (1-4): ");
                scanf("%d", &seat);

                /* Validate row */
                if(row < 1 || row > ROWS)
                {
                    printf("\nInvalid row number!\n");
                    break;
                }

                /* Validate seat */
                if(seat < 1 || seat > SEATS)
                {
                    printf("\nInvalid seat number!\n");
                    break;
                }

                /* Check whether seat is booked */
                if(seats[row - 1][seat - 1] == 0)
                {
                    printf("\nNo booking found for this seat.\n");
                    break;
                }

                /* Find passenger */
                found = 0;

                for(i = 0; i < ROWS * SEATS; i++)
                {
                    if(passenger[i].booked == 1 &&
                       passenger[i].row == row &&
                       passenger[i].seat == seat)
                    {
                        passenger[i].booked = 0;
                        found = 1;
                        break;
                    }
                }

                /* Make seat available */
                seats[row - 1][seat - 1] = 0;

                if(found == 1)
                {
                    totalBooked--;

                    printf("\nTicket cancelled successfully!\n");
                    printf("Seat %d-%d is now available.\n", row, seat);
                }

                break;


            /* -------------------------------- */
            /* 4. SEARCH PASSENGER              */
            /* -------------------------------- */
            case 4:

                printf("\nEnter passenger name: ");
                scanf(" %[^\n]", searchName);

                found = 0;

                for(i = 0; i < ROWS * SEATS; i++)
                {
                    if(passenger[i].booked == 1 &&
                       strcmp(passenger[i].name, searchName) == 0)
                    {
                        printf("\n================================\n");
                        printf("         PASSENGER FOUND\n");
                        printf("================================\n");
                        printf("Name : %s\n", passenger[i].name);
                        printf("Age  : %d\n", passenger[i].age);
                        printf("Seat : %d-%d\n",
                               passenger[i].row,
                               passenger[i].seat);

                        found = 1;
                        break;
                    }
                }

                if(found == 0)
                {
                    printf("\nPassenger not found.\n");
                }

                break;


            /* -------------------------------- */
            /* 5. RESERVATION DETAILS           */
            /* -------------------------------- */
            case 5:

                if(totalBooked == 0)
                {
                    printf("\nNo reservations available.\n");
                    break;
                }

                printf("\n==============================================\n");
                printf("             RESERVATION DETAILS\n");
                printf("==============================================\n");

                printf("%-20s %-10s %-10s\n",
                       "Passenger", "Age", "Seat");

                printf("----------------------------------------------\n");

                for(i = 0; i < ROWS * SEATS; i++)
                {
                    if(passenger[i].booked == 1)
                    {
                        printf("%-20s %-10d %d-%d\n",
                               passenger[i].name,
                               passenger[i].age,
                               passenger[i].row,
                               passenger[i].seat);
                    }
                }

                break;

            /* -------------------------------- */
            /* 6. AVAILABLE SEATS              */
            /* -------------------------------- */
            case 6:

               printf("\n===============================\n");
               printf("        AVAILABLE SEATS\n");
               printf("===============================\n");

               printf("Total Available Seats : %d\n\n",
                     ROWS * SEATS - totalBooked);

               for(i = 0; i < ROWS; i++)
               {
                 for(j = 0; j < SEATS; j++)
                 {
                    if(seats[i][j] == 0)
                    {
                        printf("%d-%d  ", i + 1, j + 1);
                    }
                    else
                    {
                        printf("XX    ");
                    }
                 }

                 printf("\n");
               }

               break;

            /* -------------------------------- */
            /* 7. EXIT                         */
            /* -------------------------------- */
            case 7:

                printf("\nThank you for using Railway Reservation System!\n");
                break;


            /* -------------------------------- */
            /* INVALID CHOICE                 */
            /* -------------------------------- */
            default:

                printf("\nInvalid choice! Please select 1-7.\n");
        }

    } while(choice != 7);

    return 0;
}
#endif // 1